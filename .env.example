# Copy to .env (docker compose reads it automatically). Every value is optional.

# JWT signing key (>= 16 chars). Empty = generated once and stored in the data volume.
NEXFLOW_SECRET=

# Create demo@nexflow.app / demo1234 on startup. Keep false in production.
NEXFLOW_SEED_DEMO=false
NEXFLOW_ALLOW_REGISTRATION=true

# Real LLM output (any OpenAI-compatible API). Empty = LLM nodes return mock text.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Real email delivery. Empty SMTP_HOST = Email nodes do a dry run.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Advanced
# NEXFLOW_CORS_ORIGINS=http://localhost:3000
# NEXFLOW_ALLOW_PRIVATE_NETWORK=false   # true lets API/Webhook nodes reach internal addresses (SSRF risk)
# NEXFLOW_NODE_TIMEOUT=60
